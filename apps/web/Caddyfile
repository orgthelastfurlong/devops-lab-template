{
	admin off
	persist_config off
	auto_https off
	log {
		output stdout
		format json
		level INFO
	}
}

:8080 {
	encode gzip
	root * /srv
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
		-Via
	}

	log {
		output stdout
		format json
	}
}
