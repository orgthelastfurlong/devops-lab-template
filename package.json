{
  "name": "devops-lab-template",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lab/web --filter @lab/api dev",
    "dev:web": "pnpm --filter @lab/web dev",
    "dev:api": "pnpm --filter @lab/api dev",
    "build": "pnpm --filter @lab/shared build && pnpm --filter @lab/api build && pnpm --filter @lab/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @lab/shared build && pnpm --filter @lab/api prisma:generate && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @lab/api prisma:generate",
    "db:migrate:dev": "pnpm --filter @lab/api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @lab/api prisma:migrate:deploy",
    "db:studio": "pnpm --filter @lab/api prisma:studio"
  }
}
